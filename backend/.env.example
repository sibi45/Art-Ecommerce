# Application Settings
PROJECT_NAME="ArtWeb Masterpiece Gallery"
ENVIRONMENT="development"
API_V1_STR="/api"

# Security (Replace with a strong random secret in production)
SECRET_KEY="artweb-super-secret-jwt-key-change-this-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default (runs out of the box without any setup needed):
DATABASE_URL="sqlite:///./artweb.db"

# Or for PostgreSQL (Free tier on Neon.tech, Supabase, or Render):
# DATABASE_URL="postgresql://user:password@ep-sample.neon.tech/artweb?sslmode=require"

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://artweb.vercel.app"

# Initial Admin Credentials (seeded if not present)
DEFAULT_ADMIN_EMAIL="admin@artweb.com"
DEFAULT_ADMIN_PASSWORD="Admin@123"
DEFAULT_ADMIN_NAME="Gallery Curator"
